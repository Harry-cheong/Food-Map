{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "db": "docker compose -f ../food-scraper-pipeline/docker-compose.yml --env-file ../food-scraper-pipeline/.env up -d",
    "api": "cd ../food-scraper-pipeline/backend && uvicorn main:app --reload --host 127.0.0.1 --port 8000",
    "web": "vite",
    "dev": "npm run db && concurrently -n api,web -c blue,green \"npm run api\" \"npm run web\"",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.34",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.4",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
